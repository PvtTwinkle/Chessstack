# ─────────────────────────────────────────────────────────────────────────────
# Chessstack — Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Both `npm run dev` and `docker compose` read .env. It is in .gitignore and
# will not be committed. Everything below the "Required" section is optional:
# features whose variables are unset are switched off.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL credentials for the postgres container in docker-compose.yml.
# POSTGRES_PASSWORD is required. The others default to "chessstack".
POSTGRES_USER=chessstack
POSTGRES_PASSWORD=
POSTGRES_DB=chessstack

# Connection string used by `npm run dev` (docker compose builds its own from
# the POSTGRES_* values above). Use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://chessstack:YOUR_PASSWORD_HERE@localhost:5432/chessstack

# The public URL of this instance. Used for secure cookies (https:// origins),
# links in emails and Stripe checkout redirects.
# For `npm run dev` use http://localhost:5173.
ORIGIN=http://localhost:3000

# Which edition to run. "cloud" is chessstack.app: plan limits, the public
# website, and the first user to register becomes admin. Anything else
# (including unset) is a self-hosted instance: no plan limits, no public
# website, optional email at sign-up, and a default admin account.
# EDITION=selfhosted

# Self-hosted only: the admin account created on first run.
# DEFAULT_USERNAME=admin
# DEFAULT_PASSWORD=changeme

# ── Reverse proxy / client IP ────────────────────────────────────────────────

# Login, registration and password-reset rate limits are keyed on the client IP.
# Behind a reverse proxy (Railway, Cloudflare, Nginx, Caddy…) the app otherwise
# sees only the proxy's IP, so ALL users share one rate-limit bucket.
# Tell adapter-node which header carries the real client IP:
#   - X-Forwarded-For: set XFF_DEPTH to the number of trusted proxies in front
#     of the app (e.g. 1 for one proxy, 2 for Cloudflare -> Railway).
#   - CF-Connecting-IP: only if the app is reachable exclusively via Cloudflare,
#     otherwise clients can spoof this header.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# ── Registration & Access ────────────────────────────────────────────────────

# Who can create accounts: "open" (anyone) or "invite" (admin only, default).
# Cloud edition: on an empty database the first user to register becomes the admin.
# REGISTRATION_MODE=invite

# ── Email (Loops) ────────────────────────────────────────────────────────────
# https://app.loops.so — each feature switches on when its variables are set.

# API key. Also enables syncing new users to Loops as contacts.
# LOOPS_API_KEY=
# Transactional email ID for email verification (template variable: verifyUrl).
# When set, users must verify their email before using the app.
# LOOPS_TRANSACTIONAL_ID=
# Transactional email ID for password reset (template variable: resetUrl).
# LOOPS_PASSWORD_RESET_ID=

# ── Stripe Billing ───────────────────────────────────────────────────────────
# https://dashboard.stripe.com — leave blank to disable the upgrade flow.
# Webhook endpoint: https://<your-domain>/api/billing/webhook with the events
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted and invoice.payment_failed.

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_ANNUAL=price_...
# Referral program coupon: 50% off, duration "once" (Dashboard > Coupons).
# STRIPE_REFERRAL_COUPON_ID=

# ── Error Tracking (Sentry) ──────────────────────────────────────────────────
# https://sentry.io — leave blank to disable. Nothing is sent without a DSN.

# Server errors. The DSN is under Project Settings > Client Keys (DSN).
# SENTRY_DSN=https://<key>@o<org-id>.ingest.<region>.sentry.io/<project-id>
# Browser errors. Usually the same DSN (it is public by design).
# PUBLIC_SENTRY_DSN=
# Share of server requests traced for performance (0 to 1). 0 = off.
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Build time only (Docker build args): upload source maps so stack traces show
# the original code. Create the token under Settings > Auth Tokens.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ── Logging ──────────────────────────────────────────────────────────────────

# "json" (default; one JSON object per line) or "text" (default in npm run dev).
# LOG_FORMAT=json
# debug, info (default), warn or error.
# LOG_LEVEL=info

# ── Game Import ──────────────────────────────────────────────────────────────

# Auto-sync interval for Lichess/Chess.com games, in minutes. 0 = manual only.
# GAME_IMPORT_INTERVAL_MINUTES=0

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for cross-origin API requests.
# Leave empty or unset to disable CORS (default).
# CORS_ORIGINS=

# ── Seed Data ────────────────────────────────────────────────────────────────

# Directory containing the reference data dumps loaded on first boot.
# SEED_DATA_DIR=/app/data

# ── Rate Limits ──────────────────────────────────────────────────────────────
# Per user, 5-minute window. Values shown are the defaults.

# RATE_LIMIT_BOOK=120
# RATE_LIMIT_IMPORT_FETCH=10
# RATE_LIMIT_IMPORT_ANALYZE=30
# RATE_LIMIT_GAPS=30
# RATE_LIMIT_MASTERS=120
# RATE_LIMIT_ECO=120
# RATE_LIMIT_PUZZLES_NEXT=60

# Registrations per client IP per hour.
# RATE_LIMIT_REGISTER=20
