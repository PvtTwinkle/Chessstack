{
	"name": "chessstack",
	"private": true,
	"version": "1.6.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p e2e",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --project unit --project unit-svelte",
		"test:db": "vitest run --project db",
		"test:watch": "vitest --project unit --project unit-svelte",
		"test:coverage": "vitest run --project unit --project unit-svelte --coverage",
		"test:ci": "vitest run --coverage --coverage.thresholds.statements=66 --coverage.thresholds.branches=56 --coverage.thresholds.functions=74 --coverage.thresholds.lines=68",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --max-warnings 0 .",
		"format": "prettier --write .",
		"lint:security": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --max-warnings 0 .",
		"license": "license-checker-rseidelsohn --summary --excludePrivatePackages --excludePackages \"sentry@$(node -p \"require('./node_modules/sentry/package.json').version\")\" --onlyAllow 'MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;MPL-2.0;GPL-3.0-or-later;Python-2.0;Unlicense;CC0-1.0;CC-BY-3.0;CC-BY-4.0;BlueOak-1.0.0;(MIT OR WTFPL);(MIT AND CC-BY-3.0);(BSD-2-Clause OR MIT OR Apache-2.0)'"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"drizzle-kit": "^0.31.9",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-security": "^4.0.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.5.0",
		"license-checker-rseidelsohn": "^5.0.1",
		"mdsvex": "^0.12.7",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@lichess-org/chessground": "^10.4.2",
		"@sentry/sveltekit": "^11.8.0",
		"bcryptjs": "^3.0.3",
		"chess.js": "^1.4.0",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9",
		"stripe": "^23.0.0",
		"ts-fsrs": "^5.2.3",
		"zod": "^4.6.7"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		}
	}
}
