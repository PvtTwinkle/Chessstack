{
	"name": "chessstack",
	"private": true,
	"version": "1.4.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --project unit --project unit-svelte",
		"test:db": "vitest run --project db",
		"test:watch": "vitest --project unit --project unit-svelte",
		"test:coverage": "vitest run --project unit --project unit-svelte --coverage",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"lint:security": "eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.1",
		"@vitest/coverage-v8": "^5.0.3",
		"drizzle-kit": "^0.31.9",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-security": "^4.0.0",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.5.0",
		"license-checker": "^25.0.1",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@lichess-org/chessground": "^10.4.1",
		"@sentry/sveltekit": "^11.4.0",
		"bcryptjs": "^3.0.3",
		"chess.js": "^1.4.0",
		"drizzle-orm": "^0.45.1",
		"postgres": "^3.4.9",
		"stripe": "^23.0.0",
		"ts-fsrs": "^5.2.3",
		"zod": "^4.6.5"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		}
	}
}
